# ──────────────────────────────────────────────────────────────────────────
# HealthPoints — environment variable reference (monorepo)
#
# This file documents every env var used across the repo. It is NOT loaded
# directly. Copy the backend values into backend/.env (gitignored) for local
# dev. The frontend does NOT use .env — its API URL is baked at build time
# from src/environments/environment*.ts (see README "Environments").
# ──────────────────────────────────────────────────────────────────────────

# ─── Backend (backend/.env locally · Worker secrets/vars when deployed) ───

# Local Express port. Not used on Cloudflare Workers.
PORT=4000

# Postgres connection string.
#   • Local:  postgres://postgres:postgres@localhost:5432/healthpoints
#   • Neon (pooled, per branch):
#       postgres://<user>:<pass>@<branch-host>-pooler.<region>.aws.neon.tech/healthpoints?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/healthpoints

# Allowed frontend origin for CORS. In production set this to the Pages URL,
# e.g. https://healthpoints.pages.dev (dev Worker uses the dev Pages origin).
CORS_ORIGIN=http://localhost:4200

# ─── Frontend (reference only — set in src/environments/environment*.ts) ───
# environment.ts       (dev)  → apiBaseUrl: http://localhost:4000/api/v1
# environment.prod.ts  (prod) → apiBaseUrl: https://<prod-worker>.workers.dev/api/v1
